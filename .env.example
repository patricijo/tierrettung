# ============================================================================
# TIERRETTUNG KOMPASS – BEISPIEL-KONFIGURATION (.env.example)
# Kopiere diese Datei nach `.env` und trage deine echten Zugangsdaten ein:
#   cp .env.example .env
# ============================================================================

# --- 1. MONGODB DATENBANK (Nur Server-seitig / Backend) ---
MONGODB_URI=mongodb://127.0.0.1:27017/tierrettung_kompass
MONGODB_DB_NAME=tierrettung_kompass

# --- 2. ADMIN-ZUGANGSDATEN & SIGNATUR-SECRET (Nur Server-seitig / Backend) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
ADMIN_TOKEN_SECRET=change-me-random-64-char-hex-secret
PORT=3001

# --- 3. BETREIBERDATEN FÜR IMPRESSUM & DATENSCHUTZ (Frontend via VITE_*) ---
VITE_OPERATOR_NAME="Max Mustermann (Muster-Initiative TierRettung)"
VITE_OPERATOR_STREET="Musterstraße 12"
VITE_OPERATOR_CITY="10115 Berlin, Deutschland"
VITE_OPERATOR_EMAIL="kontakt@beispiel-tierrettung.de"
VITE_OPERATOR_PHONE="+49 (0) 30 12345678"
VITE_RESPONSIBLE_PERSON="Max Mustermann"
VITE_HOSTING_PROVIDER="Cloud- / Webhosting (Serverstandort: Europäische Union / Deutschland)"

# --- 4. KARTEN- & GEOCODING-ENDPUNKTE ---
VITE_OSM_NOMINATIM_URL="https://nominatim.openstreetmap.org"
VITE_OSM_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
